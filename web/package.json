{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "corepack pnpm run typecheck && next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "test:http:built": "node --test tests/http-contracts.contract.mjs",
    "test:http": "corepack pnpm run build && corepack pnpm run test:http:built",
    "test:browser:built": "playwright test",
    "test:browser": "NEXT_PUBLIC_GTM_ID=G-PLAYWRIGHT corepack pnpm run build && corepack pnpm run test:browser:built",
    "lint": "oxlint && eslint",
    "typecheck": "tsc --noEmit",
    "check": "corepack pnpm run test && corepack pnpm run check:analytics-env && corepack pnpm run lint && NEXT_PUBLIC_GTM_ID=G-PLAYWRIGHT corepack pnpm run build && corepack pnpm run test:http:built && corepack pnpm run test:browser:built && corepack pnpm run check:seo",
    "check:security": "corepack pnpm audit --audit-level high",
    "check:seo": "node scripts/check-seo.mjs",
    "check:seo:live": "node scripts/check-live-seo.mjs",
    "check:analytics-env": "node scripts/validate-analytics-env.mjs",
    "check:analytics-env:prod": "node scripts/validate-analytics-env.mjs --strict"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/firewall": "^1.2.6",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/eslint-plugin-next": "16.4.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
