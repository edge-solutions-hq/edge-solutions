{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "corepack pnpm run typecheck && next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint && eslint",
    "typecheck": "tsc --noEmit",
    "check": "corepack pnpm run test && corepack pnpm run check:analytics-env && corepack pnpm run lint && corepack pnpm run build && corepack pnpm run check:seo",
    "check:seo": "node scripts/check-seo.mjs",
    "check:seo:live": "node scripts/check-live-seo.mjs",
    "check:analytics-env": "node scripts/validate-analytics-env.mjs",
    "check:analytics-env:prod": "node scripts/validate-analytics-env.mjs --strict"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.10",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "clsx": "^2.1.1",
    "next": "^16.2.10",
    "next-intl": "^4.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2.10",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "npm:typescript@^7.0.2",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "oxlint": "^1.74.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2"
  }
}
