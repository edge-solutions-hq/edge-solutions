## Resend
# Create an API key in Resend dashboard.
RESEND_API_KEY=

# For testing you can keep onboarding@resend.dev.
# Once edge-solutions.be is verified in Resend, switch to something like:
# RESEND_FROM_EMAIL=Edge Solutions <contact@edge-solutions.be>
RESEND_FROM_EMAIL=Edge Solutions <onboarding@resend.dev>

# Where contact messages are delivered
RESEND_TO_EMAIL=edgesolutionsgg@gmail.com

## Analytics (optional)
# Google tag ID / GA4 Measurement ID (example: G-XXXXXXXXXX)
# When set, gtag.js is available after the visitor explicitly opts in.
NEXT_PUBLIC_GTM_ID=

